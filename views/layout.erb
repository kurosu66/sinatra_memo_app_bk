<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Soccer Match Record</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
  <header class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2a10 10 0 0 1 7.39 16.71M12 2a10 10 0 0 0-7.39 16.71M4.61 18.71A10 10 0 0 0 12 22M19.39 18.71A10 10 0 0 1 12 22"/>
          <path d="M12 7l2.5 4H9.5L12 7zM12 17l-2.5-4h5L12 17z"/>
        </svg>
        <span class="logo-text">Soccer Record</span>
      </a>
      <a href="/matches/new" class="btn-nav-new">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        新しい試合
      </a>
    </div>
  </header>

  <main>
    <%= yield %>
  </main>

  <footer class="footer">
    <p>Soccer Match Record</p>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
