<!-- Upload View -->
<section id="upload-view" class="view active">
  <div class="hero">
    <div class="hero-content">
      <div class="hero-badge">AI Video Analysis</div>
      <h1 class="hero-title">サッカー試合<br><span class="accent">動画解析</span></h1>
      <p class="hero-desc">試合動画をアップロードするだけで、AIが選手の採点・スタッツを自動分析します。</p>
      <button class="btn-demo" onclick="showDemo()">▶ デモ結果を見る</button>
    </div>
  </div>

  <div class="upload-container">
    <!-- タブ切替 -->
    <div class="input-tabs">
      <button class="input-tab active" id="tab-file" onclick="switchTab('file')">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        動画ファイル
      </button>
      <button class="input-tab" id="tab-youtube" onclick="switchTab('youtube')">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
        YouTube URL
      </button>
    </div>

    <!-- ファイルアップロードパネル -->
    <div id="panel-file">
      <div id="drop-zone" class="drop-zone">
        <input type="file" id="video-input" accept="video/*" style="display:none">
        <div class="drop-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <p class="drop-title">動画ファイルをドロップ</p>
        <p class="drop-sub">または <button class="browse-btn" onclick="document.getElementById('video-input').click()">ファイルを選択</button></p>
        <p class="drop-hint">MP4, MOV, AVI など対応 · 最大 2GB</p>
      </div>

      <div id="video-preview-area" class="video-preview-area hidden">
        <video id="video-preview" controls muted playsinline></video>
        <div class="preview-info">
          <div class="file-info">
            <span id="file-name" class="file-name"></span>
            <span id="file-size" class="file-size"></span>
          </div>
          <div class="frame-info">
            <span id="frame-count-label"></span>
          </div>
        </div>
        <div class="preview-actions">
          <button class="btn-secondary" onclick="resetUpload()">別の動画を選択</button>
          <button class="btn-primary" id="analyze-btn" onclick="startAnalysis()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            AIで分析する
          </button>
        </div>
      </div>
    </div>

    <!-- YouTube URLパネル -->
    <div id="panel-youtube" class="hidden">
      <div class="yt-panel">
        <div class="yt-input-wrap">
          <svg class="yt-icon" width="20" height="20" viewBox="0 0 24 24" fill="#ff0000"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
          <input type="url" id="yt-url-input" class="yt-input"
            placeholder="https://www.youtube.com/watch?v=..."
            oninput="onYtUrlInput(this.value)" />
        </div>
        <div id="yt-preview-wrap" class="yt-preview-wrap hidden">
          <img id="yt-thumbnail" class="yt-thumbnail" src="" alt="サムネイル">
          <div class="yt-meta">
            <div id="yt-title" class="yt-title"></div>
            <div class="yt-warning">⚠️ サーバー側でダウンロードします。yt-dlp と ffmpeg が必要です。</div>
          </div>
        </div>
        <button class="btn-primary yt-analyze-btn" id="yt-analyze-btn" onclick="startYouTubeAnalysis()" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          YouTubeを解析する
        </button>
      </div>
    </div>
  </div>

  <div class="features-grid">
    <div class="feature-card">
      <div class="feature-icon">📊</div>
      <h3>選手評価</h3>
      <p>1〜10のレーティングで各選手のパフォーマンスを採点</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">⚡</div>
      <h3>詳細スタッツ</h3>
      <p>ゴール、アシスト、パス精度、タックルなど多彩な統計</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">🏆</div>
      <h3>MVP選出</h3>
      <p>試合で最も活躍した選手をAIが自動で選出</p>
    </div>
  </div>
</section>

<!-- Progress View -->
<section id="progress-view" class="view hidden">
  <div class="progress-container">
    <div class="progress-animation">
      <div class="progress-ball"></div>
      <div class="progress-field"></div>
    </div>
    <h2 class="progress-title">動画を分析中...</h2>
    <p class="progress-subtitle" id="progress-subtitle">フレームを抽出しています</p>
    <div class="progress-steps">
      <div class="step active" id="step-1">
        <div class="step-icon">🎬</div>
        <span>フレーム抽出</span>
      </div>
      <div class="step-arrow">→</div>
      <div class="step" id="step-2">
        <div class="step-icon">🤖</div>
        <span>AI分析</span>
      </div>
      <div class="step-arrow">→</div>
      <div class="step" id="step-3">
        <div class="step-icon">📋</div>
        <span>レポート生成</span>
      </div>
    </div>
    <div class="progress-bar-wrap">
      <div class="progress-bar" id="progress-bar"></div>
    </div>
    <p class="progress-note">動画の長さによって数分かかる場合があります</p>
  </div>
</section>

<!-- Results View -->
<section id="results-view" class="view hidden">
  <div class="results-header">
    <button class="btn-back" onclick="resetToUpload()">
      ← 新しい動画を分析
    </button>
    <div class="results-disclaimer">⚠️ AIによる推定分析です</div>
  </div>
  <div id="results-content"></div>
</section>
