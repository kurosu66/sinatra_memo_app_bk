<section class="list-view">
  <div class="list-header">
    <h1 class="page-title">試合記録</h1>
    <a href="/matches/new" class="btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      新しい試合を記録
    </a>
  </div>

  <% if @matches.empty? %>
    <div class="empty-state">
      <div class="empty-icon">⚽</div>
      <p class="empty-title">まだ試合が記録されていません</p>
      <a href="/matches/new" class="btn-primary" style="margin-top:16px">最初の試合を記録する</a>
    </div>
  <% else %>
    <div class="match-list">
      <% @matches.each do |m| %>
        <a href="/matches/<%= m['id'] %>" class="match-card-link">
          <div class="match-card">
            <div class="match-card-left">
              <div class="match-date"><%= m['date'] || '日付未設定' %></div>
              <div class="match-teams">
                <span class="team-name home-name"><%= m['home_team'] || 'ホーム' %></span>
                <span class="score-chip">
                  <span class="score-h"><%= m['home_score'] %></span>
                  <span class="score-sep"> - </span>
                  <span class="score-a"><%= m['away_score'] %></span>
                </span>
                <span class="team-name away-name"><%= m['away_team'] || 'アウェイ' %></span>
              </div>
              <% if m['location'] && !m['location'].empty? %>
                <div class="match-location">📍 <%= m['location'] %></div>
              <% end %>
            </div>
            <div class="match-card-right">
              <span class="player-count"><%= m['players']&.size || 0 %>名</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted)"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>
</section>
